#################################################
## 6) PROFILE CREATION (uses the SAME email as login)
##    Endpoints:
##      - /user-master
##      - /user-administrator
##      - /user-teacher
##      - /user-student
##      - /user-worker
#################################################

### createMasterProfile
# @name createMasterProfile
# Authorization with master token; email == master login email
POST {{baseUrl}}/user-master
Authorization: {{masterToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{masterEmail}}",
  "birthday": "{{birthday}}",
  "cnpj": "{{cnpj}}"
}
###
# Adjust to your response shape if needed:
@masterProfileId = {{createMasterProfile.response.body.id}}

### createAdministratorProfile
# @name createAdministratorProfile
# Authorization with admin token; email == admin login email
POST {{baseUrl}}/user-administrator
Authorization: {{masterToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "middleName": "{{middleName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{adminEmail}}",
  "birthday": "{{birthday}}",
  "salary": { "salary": {{salaryValue}}, "currency": "{{salaryCurrency}}" },
  "graduation": "{{graduation}}"
}
###
@administratorProfileId = {{createAdministratorProfile.response.body.id}}

### createTeacherProfile
# @name createTeacherProfile
# Authorization with teacher token; email == teacher login email
POST {{baseUrl}}/user-teacher
Authorization: {{teacherToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "middleName": "{{middleName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{teacherEmail}}",
  "birthday": "{{birthday}}",
  "salary": { "salary": {{salaryValue}}, "currency": "{{salaryCurrency}}" },
  "graduation": "{{graduation}}",
  "academicDegrees": "{{academicDegrees}}"
}
###
@teacherProfileId = {{createTeacherProfile.response.body.id}}

### createStudentProfile
# @name createStudentProfile
# Authorization with student token; email == student login email
POST {{baseUrl}}/user-student
Authorization: {{studentToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "middleName": "{{middleName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{studentEmail}}",
  "birthday": "{{birthday}}",
  "paymentYear": 2025
}
###
@studentProfileId = {{createStudentProfile.response.body.id}}

### createWorkerProfile
# @name createWorkerProfile
# Authorization with worker token; email == worker login email
POST {{baseUrl}}/user-worker
Authorization: {{workerToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "middleName": "{{middleName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{workerEmail}}",
  "birthday": "{{birthday}}",
  "salary": { "salary": {{salaryValue}}, "currency": "{{salaryCurrency}}" }
}
###
@workerProfileId = {{createWorkerProfile.response.body.id}}


#################################################
## 7) OTHER ENDPOINTS (CRUD per profile)
## Using master token for admin operations; adjust tokens as needed.
#################################################

############ MASTER ############

### listMasterProfiles
GET {{baseUrl}}/user-master
Authorization: {{masterToken}}

### getMasterProfileById
GET {{baseUrl}}/user-master/{{masterProfileId}}
Authorization: {{masterToken}}

### updateMasterProfile
PATCH {{baseUrl}}/user-master/{{masterProfileId}}
Authorization: {{masterToken}}
Content-Type: application/json

{
  "name": { "firstName": "{{firstName}}", "middleName": "{{middleName}}", "lastName": "{{lastName}}" },
  "address": {
    "street": "{{street}}",
    "city": "{{city}}",
    "zip": "{{zip}}",
    "number": {{number}},
    "avenue": "{{avenue}}",
    "state": "{{state}}"
  },
  "email": "{{masterEmail}}",
  "birthday": "{{birthday}}",
  "cnpj": "{{cnpj}}"
}

### deleteMasterProfile
DELETE {{baseUrl}}/user-master/{{masterProfileId}}
Authorization: {{masterToken}}


