#################################################
## Variables
#################################################

@baseUrl = http://localhost:3003

@masterEmail  = master@teste.com.br
@adminEmail   = admin@teste.com.br
@teacherEmail = teacher@teste.com.br
@studentEmail = student@teste.com.br
@workerEmail  = worker@teste.com.br

@masterPassword  = MasterPass123
@adminPassword   = AdminPass123
@teacherPassword = TeacherPass123
@studentPassword = StudentPass123
@workerPassword  = WorkerPass123

@cnpj = 35.741.901/0001-58

# Sample profile data (adjust as needed)
@firstName = John
@middleName = 
@lastName = Doe
@street = 1st Street
@avenue = Central Ave
@number = 123
@city = Metropolis
@state = SP
@zip = 01000-000
@birthday = 1990-01-15
@graduation = Business Administration
@academicDegrees = MSc, PhD
@salaryValue = 10000
@salaryCurrency = R$


#################################################
## 1) MASTER login (Init -> get masterId -> Login)
#################################################

### loginMasterInit
# @name loginMasterInit
# Discover masterId (without sending masterId)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{masterEmail}}",
  "password": "{{masterPassword}}",
  "role": "master"
}
###
@masterId = {{loginMasterInit.response.body.data.0.id}}

### loginMaster
# @name loginMaster
# Login with masterId to get token
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{masterEmail}}",
  "password": "{{masterPassword}}",
  "role": "master",
  "masterId": "{{masterId}}"
}
###
@masterToken = Bearer {{loginMaster.response.body.token}}


#################################################
## 2) ADMINISTRATOR login (Init -> get masterId -> Login)
#################################################

### loginAdminInit
# @name loginAdminInit
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "role": "administrator"
}
###
@adminMasterId = {{loginAdminInit.response.body.data.0.id}}

### loginAdmin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "role": "administrator",
  "masterId": "{{adminMasterId}}"
}
###
@adminToken = Bearer {{loginAdmin.response.body.token}}


